// Prisma schema — MongoDB
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId
  username        String         @unique
  name            String
  surname         String
  fullname        String
  email           String         @unique
  password        String // argon2id hash, never the plain password
  role            UserRole       @default(MEMBER)
  steamId         String?
  steamUsername   String?
  avatar          String?
  clanMemberships ClanMember[]
  refreshTokens   RefreshToken[]
  accessTokens    AccessToken[]
  clanPosts       ClanPost[]
  servers         UserServer[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Clan {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  clanName  String
  clanTag   String       @unique
  clanHref  String       @unique
  region    Region
  members   ClanMember[]
  servers   ClanServer[]
  posts     ClanPost[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ROB RUN server regions. Keep in sync with lib/src/regions.ts.
// Site-wide role of a user (separate from clan ranks in ClanRole).
enum UserRole {
  MEMBER
  MOD
  ADMIN
}

enum Region {
  EU
  NA
}

// Clan ranks as used in ROB RUN, highest to lowest.
enum ClanRole {
  LEADER
  OFFICER
  FIGHTER
  RECRUIT
}

model ClanMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  clanId    String   @db.ObjectId
  role      ClanRole @default(RECRUIT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  // A user can only be a member of the same clan once.
  @@unique([userId, clanId])
  @@index([clanId])
}

model Server {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  serverName String
  beganAt    DateTime
  clans      ClanServer[]
  players    UserServer[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// Why a refresh token was revoked. Only ROTATED tokens get the short reuse
// grace period (parallel requests); the others are dead immediately.
enum TokenRevokeReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
}

// Refresh tokens for the auth system. Only a SHA-256 hash of the token is
// stored; the raw token lives in an httpOnly cookie on the client.
// Tokens are rotated on every refresh: the old one is revoked and points to
// its replacement. Reusing a revoked token revokes all tokens of the user.
model RefreshToken {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash     String             @unique
  userId        String             @db.ObjectId
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason TokenRevokeReason?
  replacedById  String?            @db.ObjectId
  userAgent     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  accessTokens AccessToken[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Access tokens: short-lived random tokens (no JWT). Only a SHA-256 hash is
// stored. Each one belongs to the refresh token (session) that issued it, so
// logging out deletes the session's access tokens immediately.
model AccessToken {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash      String   @unique
  userId         String   @db.ObjectId
  refreshTokenId String   @db.ObjectId
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken @relation(fields: [refreshTokenId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenId])
}

// Servers a clan plays on. A clan can have many servers and a server many
// clans. Only active servers can be added (see lib/src/serverLifetime.ts).
model ClanServer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clanId    String   @db.ObjectId
  serverId  String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // A server can be added to the same clan only once.
  @@unique([clanId, serverId])
  @@index([serverId])
}

// Blog posts on the wall of a clan. `rawContent` is the editor document
// (RTEDocument), used to edit the post again. `content` is the HTML rendered
// from it on the server, it is never taken from the client.
model ClanPost {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  clanId     String   @db.ObjectId
  authorId   String   @db.ObjectId
  title      String
  rawContent Json
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clan   Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clanId, createdAt])
  @@index([authorId])
}

// Servers a player is assigned to. A player can have many servers and a server
// many players. Only active servers can be added (see lib/src/serverLifetime.ts).
model UserServer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  serverId  String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // A player can be assigned to the same server only once.
  @@unique([userId, serverId])
  @@index([serverId])
}
