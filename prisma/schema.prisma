// Prisma schema — MongoDB
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  username         String            @unique
  name             String
  surname          String
  fullname         String
  email            String            @unique
  password         String // argon2id hash, never the plain password
  role             UserRole          @default(MEMBER)
  steamId          String?
  steamUsername    String?
  avatar           String?
  clanMemberships  ClanMember[]
  refreshTokens    RefreshToken[]
  accessTokens     AccessToken[]
  clanPosts        ClanPost[]
  lfcListing       LfcListing?
  clanJoinRequests ClanJoinRequest[]
  clanInvites      ClanInvite[]
  notifications    Notification[]
  servers          UserServer[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// How players join a clan: only by invite, by a request the leader or an officer
// accepts, or open to everyone.
enum ClanJoinMode {
  INVITE
  REQUEST
  OPEN
}

model Clan {
  id           String            @id @default(auto()) @map("_id") @db.ObjectId
  clanName     String
  clanTag      String            @unique
  clanHref     String            @unique
  region       Region
  // Id of a ready-made avatar (lib/src/clanAvatars.ts).
  avatar       String?
  joinMode     ClanJoinMode      @default(REQUEST)
  members      ClanMember[]
  servers      ClanServer[]
  posts        ClanPost[]
  lfpListing   LfpListing?
  inventory    ClanInventoryItem[]
  joinRequests ClanJoinRequest[]
  invites      ClanInvite[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// ROB RUN server regions. Keep in sync with lib/src/regions.ts.
// Site-wide role of a user (separate from clan ranks in ClanRole).
enum UserRole {
  MEMBER
  MOD
  ADMIN
}

enum Region {
  EU
  NA
}

// Clan ranks as used in ROB RUN, highest to lowest.
enum ClanRole {
  LEADER
  OFFICER
  FIGHTER
  RECRUIT
}

model ClanMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  clanId    String   @db.ObjectId
  role      ClanRole @default(RECRUIT)
  // Priority of the rank (lib/src/clanRoles.ts), higher is more powerful. Always
  // written together with `role`.
  priority  Int      @default(1)
  inventory ClanInventoryItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  // A user can only be a member of the same clan once.
  @@unique([userId, clanId])
  @@index([clanId, priority])
}

model Server {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  serverName String
  beganAt    DateTime
  clans      ClanServer[]
  players    UserServer[]
  inventory  ClanInventoryItem[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

// Why a refresh token was revoked. Only ROTATED tokens get the short reuse
// grace period (parallel requests); the others are dead immediately.
enum TokenRevokeReason {
  ROTATED
  LOGOUT
  REUSE_DETECTED
}

// Refresh tokens for the auth system. Only a SHA-256 hash of the token is
// stored; the raw token lives in an httpOnly cookie on the client.
// Tokens are rotated on every refresh: the old one is revoked and points to
// its replacement. Reusing a revoked token revokes all tokens of the user.
model RefreshToken {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash     String             @unique
  userId        String             @db.ObjectId
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason TokenRevokeReason?
  replacedById  String?            @db.ObjectId
  userAgent     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  accessTokens AccessToken[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Access tokens: short-lived random tokens (no JWT). Only a SHA-256 hash is
// stored. Each one belongs to the refresh token (session) that issued it, so
// logging out deletes the session's access tokens immediately.
model AccessToken {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash      String   @unique
  userId         String   @db.ObjectId
  refreshTokenId String   @db.ObjectId
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken @relation(fields: [refreshTokenId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenId])
}

// Servers a clan plays on. A clan can have many servers and a server many
// clans. Only active servers can be added (see lib/src/serverLifetime.ts).
model ClanServer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clanId    String   @db.ObjectId
  serverId  String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clan   Clan   @relation(fields: [clanId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // A server can be added to the same clan only once.
  @@unique([clanId, serverId])
  @@index([serverId])
}

// Who can see a clan post: everyone or only members of the clan.
enum PostVisibility {
  PUBLIC
  MEMBER
}

// Blog posts on the wall of a clan. `rawContent` is the editor document
// (RTEDocument), used to edit the post again. `content` is the HTML rendered
// from it on the server, it is never taken from the client.
model ClanPost {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  clanId     String         @db.ObjectId
  authorId   String         @db.ObjectId
  title      String
  rawContent Json
  content    String
  visibility PostVisibility @default(PUBLIC)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  clan   Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([clanId, visibility, createdAt])
  @@index([authorId])
}

// Servers of a player. Only one is active (`isActive`), the others are history.
// Only servers within their lifetime can be chosen (lib/src/serverLifetime.ts).
// The location is per server: `district` and `settlement` are set together or
// not at all (lib/src/constants.ts).
model UserServer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  serverId   String   @db.ObjectId
  isActive   Boolean  @default(true)
  district   String?
  settlement Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([userId, isActive])
  @@index([serverId])
}

// Item a member has on a server, shown in the inventory of their clan. Only
// items on active servers are shown (lib/src/serverLifetime.ts). Deleted with the
// membership, so members who leave take their items with them.
model ClanInventoryItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clanId    String   @db.ObjectId
  memberId  String   @db.ObjectId
  serverId  String   @db.ObjectId
  // Id of an item in lib/src/items.ts.
  itemId    String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clan   Clan       @relation(fields: [clanId], references: [id], onDelete: Cascade)
  member ClanMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  server Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)

  // A member lists the same item on a server only once.
  @@unique([memberId, serverId, itemId])
  @@index([clanId, updatedAt])
  @@index([serverId])
}

// Looking for clan: listing of a player who searches for a clan, on the active
// servers they chose. Expired servers are not shown.
model LfcListing {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  region    Region
  message   String
  serverIds String[] @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Looking for player: listing of a clan that searches for players for a rank, on
// some of its active servers. Its region is that of the clan. Only servers the
// clan still plays on are shown.
model LfpListing {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  clanId    String    @unique @db.ObjectId
  message   String
  serverIds String[]  @db.ObjectId
  // Rank the clan is looking for, never LEADER. Missing on old listings (RECRUIT).
  role      ClanRole?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
}

// Player who asked to join a clan (REQUEST mode).
model ClanJoinRequest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clanId    String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
  @@index([userId])
}

// Player invited to a clan by its leader or an officer.
model ClanInvite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clanId    String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clan Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clanId, userId])
  @@index([userId])
}

enum NotificationType {
  CLAN_JOIN_REQUEST
  CLAN_REQUEST_ACCEPTED
  CLAN_REQUEST_REJECTED
  CLAN_INVITE
  CLAN_MEMBER_JOINED
  CLAN_ROLE_CHANGED
  CLAN_REMOVED
}

// Notification of a user. No text is saved: it is translated from `type` and
// `params` in the language of the reader.
model Notification {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  type      NotificationType
  params    Json
  // Page on this site that opens on click. Without it nothing opens.
  href      String?
  isRead    Boolean          @default(false)
  // What it is about. A new notification replaces an unread one with the same
  // key, so nobody can flood a user by repeating an action.
  sourceKey String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}
